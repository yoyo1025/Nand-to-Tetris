// File name: projects/1/DMux8Way.hdl
/**
 * 8-way demultiplexor:
 * [a, b, c, d, e, f, g, h] = [in, 0,  0,  0,  0,  0,  0,  0] if sel = 000
 *                            [0, in,  0,  0,  0,  0,  0,  0] if sel = 001
 *                            [0,  0, in,  0,  0,  0,  0,  0] if sel = 010
 *                            [0,  0,  0, in,  0,  0,  0,  0] if sel = 011
 *                            [0,  0,  0,  0, in,  0,  0,  0] if sel = 100
 *                            [0,  0,  0,  0,  0, in,  0,  0] if sel = 101
 *                            [0,  0,  0,  0,  0,  0, in,  0] if sel = 110
 *                            [0,  0,  0,  0,  0,  0,  0, in] if sel = 111
 */
CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    //// Replace this comment with your code.
    DMux(in=in, sel=sel[0], a=dMuxOut1, b=dMuxOut2);
    DMux(in=dMuxOut1, sel=sel[1], a=dMuxOut3, b=dMuxOut4);
    DMux(in=dMuxOut2, sel=sel[1], a=dMuxOut5, b=dMuxOut6);
    DMux(in=dMuxOut3, sel=sel[2], a=a, b=e);
    DMux(in=dMuxOut4, sel=sel[2], a=c, b=g);
    DMux(in=dMuxOut5, sel=sel[2], a=b, b=f);
    DMux(in=dMuxOut6, sel=sel[2], a=d, b=h);
}
